# Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# Application
# ===================
APP_NAME=Insightyfy
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# ===================
# Database
# ===================
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/insightyfy

# ===================
# Redis
# ===================
REDIS_URL=redis://localhost:6379/0

# ===================
# Firebase
# ===================
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=insightify-4b4ee

# ===================
# Cloudflare R2
# ===================
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_BUCKET=insightyfy-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ===================
# Gemini API (Primary AI)
# ===================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ===================
# Hive API (Fallback)
# ===================
HIVE_API_KEY=
HIVE_API_URL=https://api.thehiveai.com/api/v2

# ===================
# Rate Limits
# ===================
# Free tier limits (per day)
FREE_TEXT_DETECTIONS_DAILY=10
FREE_AUDIO_DETECTIONS_DAILY=3
FREE_VIDEO_DETECTIONS_DAILY=0
FREE_POSTS_DAILY=3

# Premium tier limits (per day)
PREMIUM_TEXT_DETECTIONS_DAILY=100
PREMIUM_AUDIO_DETECTIONS_DAILY=50
PREMIUM_VIDEO_DETECTIONS_DAILY=20
PREMIUM_POSTS_DAILY=20

# ===================
# CORS
# ===================
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
